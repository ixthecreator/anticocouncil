# Copy to .env.local and use the Web app configuration from your Firebase console.
# VITE_* values are public client configuration, never service-account private keys.
# Add the same variables in Vercel before building. No Gemini key is required.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_DATABASE_ID=(default)

# Optional hosted Workbench integrations. Set these in the Vercel environment.
# Keep these server-only. The WeChat account must allow the deployment's egress IP.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
