# Copy to .env.local and use the Web app configuration from your Firebase console.
# VITE_* values are public client configuration, never service-account private keys.
# Add the same variables in Vercel before building. No Gemini key is required.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_DATABASE_ID=(default)

# Vercel Node function only. Set using secret environment-variable management.
# Use a dedicated identity scoped to the same project; never prefix this with VITE_.
# See docs/private-voting-deployment.md before enabling the private voting API.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Set true during the legacy-vote migration; ordinary API writes then return 503.
PRIVATE_VOTING_MAINTENANCE=false
