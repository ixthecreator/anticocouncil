# Copy to .env.local and use the Web app configuration from your Firebase console.
# VITE_* values are public client configuration, never service-account private keys.
# Add the same variables in Vercel before building. No Gemini key is required.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_DATABASE_ID=(default)

# Optional hosted Workbench integrations. Set these in the Vercel environment.
# Keep these server-only. The WeChat account must allow the deployment's egress IP.
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Optional WeChat Open Platform component authorization. Server-side only.
# Reuse WECHAT_APP_ID as the allowed account, or set WECHAT_SCAN_ACCOUNT_ID.
WECHAT_SCAN_ORIGIN=https://www.anticocouncil.com
WECHAT_SCAN_ACCOUNT_ID=
WECHAT_COMPONENT_APP_ID=
WECHAT_COMPONENT_APP_SECRET=
WECHAT_COMPONENT_TOKEN=
WECHAT_COMPONENT_AES_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
