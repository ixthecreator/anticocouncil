# Copy to .env.local and use the Web app configuration from your Firebase console.
# VITE_* values are public client configuration, never service-account private keys.
# Add the same variables in Vercel before building. No Gemini key is required.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_DATABASE_ID=(default)

# Tencent CloudBase build instead of Firebase; steps in docs/cloudbase.md.
# Leave VITE_CLOUD_BACKEND empty to keep building the Firebase version.
VITE_CLOUD_BACKEND=
VITE_CLOUDBASE_ENV_ID=
VITE_CLOUDBASE_REGION=ap-shanghai
